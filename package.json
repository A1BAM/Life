{
  "name": "life",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user life dashboard on Cloudflare Workers + Neon",
  "main": "worker/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cd web && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "psql \"$DATABASE_URL\" -f sql/001_init.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f sql/seed_demo.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@neondatabase/serverless": "^1.1.0",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "type": "module"
}